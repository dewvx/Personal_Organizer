PORT=5000
NODE_ENV=development

# PostgreSQL Connection
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=personal_organizer

# Frontend Origin for CORS
CLIENT_URL=http://localhost:5173

# Web Push Notification VAPID Keys (Generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@personalorganizer.app

# Security & Session Token Secret
AUTH_SECRET=your_super_secret_auth_key_min_32_characters
